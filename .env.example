[TEMPLATE]
# ============================================================
# ARKXMotion Studio — Environment Variables
# Copy file ini ke `.env` lalu isi nilainya:
#   cp .env.example .env   (Linux/Mac)  |  copy .env.example .env   (Windows)
# JANGAN commit file `.env` asli — isi rahasia (password/API key)!
# ============================================================

# ─── SMTP (email verifikasi & reset password) ──────────────────────────
# Wajib diisi agar email benar-benar terkirim. Bila kosong, app tetap
# berjalan tapi email hanya di-log ke console server + link ditampilkan
# langsung di UI (mode dev). Lihat SMTP_SETUP.md untuk panduan lengkap
# (Gmail App Password, Brevo, Zoho).

SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (disarankan) · 465 = SSL/TLS · 2525 = alternatif (Brevo)
SMTP_PORT=587
# 'true' hanya untuk port 465 (koneksi SSL). Untuk 587 biarkan false.
SMTP_SECURE=false
# Gmail/Zoho: alamat email lengkap. Brevo: email login akun Brevo.
SMTP_USER=you@gmail.com
# Gmail/Zoho: App Password (bukan password akun!). Brevo: SMTP key.
SMTP_PASS=your-app-password-or-smtp-key
# Alamat pengirim yang muncul di email (default: SMTP_USER)
MAIL_FROM=ARKXMotion Studio <you@gmail.com>

# ─── App URL (dipakai untuk membangun link verifikasi/reset) ───────────
# Lokal: http://localhost:5173
# Produksi (Vercel): https://arkxmotion-studio.vercel.app
APP_URL=http://localhost:5173

# ─── Backend server (opsional) ─────────────────────────────────────────
# Port Express lokal. Hati-hati: beberapa mesin punya PORT=0 di env global,
# server/index.ts sudah fallback ke 6000.
PORT=6000

# Secret untuk JWT (auth). WAJIB diisi — app tidak akan start tanpa ini!
# Generate dengan: openssl rand -hex 32
JWT_SECRET=
# Refresh token secret (otomatis fallback ke JWT_SECRET-refresh jika kosong)
JWT_REFRESH_SECRET=
# Secret untuk cron internal (GET /api/cron/daily-stats) — set random 32 char
CRON_SECRET=change-me-random-32-char

# ─── Produksi (Vercel / Neon) ──────────────────────────────────────────
# Hanya dibutuhkan di deployment Vercel (api/*.ts serverless).
# DATABASE_URL=postgres://user:pass@host/neondb

# ─── Proxy NexaBot (opsional) ──────────────────────────────────────────
# nexabot.id /credit & /credits sering lambat (~30s) dan menggantung kalau
# ditembak bersamaan. Nilai di bawah adalah default yang dipakai kalau baris
# ini dibiarkan kosong — isi hanya bila perlu melonggarkan saat upstream ramai.
# Jeda antar percobaan probe (backoff + jitter):
NEXABOT_PROXY_RETRY_BASE_MS=500
NEXABOT_PROXY_RETRY_MAX_MS=4000
# Batas Retry-After dari upstream yang mau ditunggu proxy (ms)
NEXABOT_PROXY_RETRY_MAX_RETRY_AFTER_MS=10000
# Probe saldo/sesi read-only yang boleh jalan bersamaan per instance
NEXABOT_PROBE_CONCURRENCY=2
# Batas menunggu slot antrean probe sebelum menyerah 504 (ms)
NEXABOT_PROBE_QUEUE_MAX_WAIT_MS=25000
#
# Kunci induk NexaBot: relay yang memasangnya, dan TIDAK PERNAH dikirim ke
# browser. Kosong = fitur mati (perilaku lama: klien mengirim kuncinya sendiri).
#   NEXABOT_MASTER_KEY_MODE  unlimited-or-balance (default) | unlimited | off
#   NEXABOT_MASTER_DAILY_CAP  0/kosong = tanpa batas
# Rotasi kunci lama yang masih beredar di browser: NEXABOT_MASTER_KEY.md
NEXABOT_MASTER_API_KEY=
NEXABOT_MASTER_KEY_MODE=unlimited-or-balance
NEXABOT_MASTER_DAILY_CAP=

# ─── R2 Object Storage (Cloudflare) ─────────────────────────────────────
# Untuk menyimpan permanen hasil video (mis. blob NexaBot) agar tidak hilang
# saat reload dan bisa di-share. Tanpa ini, upload ke CDN gagal dan app
# otomatis pakai URL sementara (blob:).
# Buat di: Cloudflare Dashboard → R2 Object Storage → Create Bucket,
# lalu Manage R2 API Tokens → Create API Token (Object Read & Write).
# Aktifkan public access: bucket Settings → Public Access → Allow Access
# (dapat URL https://<bucket>.<account>.r2.dev) lalu isi R2_PUBLIC_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Backup otomatis ────────────────────────────────────────────────────
# Kosong = snapshot saat start + scheduler R2 hanya jalan di production.
# Isi 1 untuk memaksa aktif (mis. saat menguji backup di lokal),
# isi 0 untuk memaksa mati walau di production.
AUTO_BACKUP=
