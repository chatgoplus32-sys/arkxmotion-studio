# ============================================================
# ARKXMotion Studio — Environment Variables
# Copy file ini ke `.env` lalu isi nilainya:
#   cp .env.example .env   (Linux/Mac)  |  copy .env.example .env   (Windows)
# JANGAN commit file `.env` asli — isi rahasia (password/API key)!
# ============================================================

# ─── SMTP (email verifikasi & reset password) ──────────────────────────
# Wajib diisi agar email benar-benar terkirim. Bila kosong, app tetap
# berjalan tapi email hanya di-log ke console server + link ditampilkan
# langsung di UI (mode dev). Lihat SMTP_SETUP.md untuk panduan lengkap
# (Gmail App Password, Brevo, Zoho).

SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (disarankan) · 465 = SSL/TLS · 2525 = alternatif (Brevo)
SMTP_PORT=587
# 'true' hanya untuk port 465 (koneksi SSL). Untuk 587 biarkan false.
SMTP_SECURE=false
# Gmail/Zoho: alamat email lengkap. Brevo: email login akun Brevo.
SMTP_USER=you@gmail.com
# Gmail/Zoho: App Password (bukan password akun!). Brevo: SMTP key.
SMTP_PASS=your-app-password-or-smtp-key
# Alamat pengirim yang muncul di email (default: SMTP_USER)
MAIL_FROM=ARKXMotion Studio <you@gmail.com>

# ─── App URL (dipakai untuk membangun link verifikasi/reset) ───────────
# Lokal: http://localhost:5173
# Produksi (Vercel): https://arkxmotion-studio.vercel.app
APP_URL=http://localhost:5173

# ─── Backend server (opsional) ─────────────────────────────────────────
# Port Express lokal. Hati-hati: beberapa mesin punya PORT=0 di env global,
# server/index.ts sudah fallback ke 6000.
PORT=6000

# Secret untuk JWT (auth). Wajib ganti di produksi dengan nilai acak!
JWT_SECRET=arkxmotion-studio-secret-key-2026

# ─── Produksi (Vercel / Neon) ──────────────────────────────────────────
# Hanya dibutuhkan di deployment Vercel (api/*.ts serverless).
# DATABASE_URL=postgres://user:pass@host/neondb
