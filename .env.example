# [TEMPLATE] — penanda bahwa file ini contoh, bukan .env asli
# ============================================================
# ARKXMotion Studio — Environment Variables
# Copy file ini ke `.env` lalu isi nilainya:
#   cp .env.example .env   (Linux/Mac)  |  copy .env.example .env   (Windows)
# JANGAN commit file `.env` asli — isi rahasia (password/API key)!
# ============================================================

# ─── SMTP (email verifikasi & reset password) ──────────────────────────
# Wajib diisi agar email benar-benar terkirim. Bila kosong, app tetap
# berjalan tapi email hanya di-log ke console server. Link hanya ditampilkan
# di UI untuk APP_URL localhost (mode dev) — di domain publik tidak pernah.
# Lihat SMTP_SETUP.md untuk panduan lengkap (Gmail App Password, Brevo, Zoho).

SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (disarankan) · 465 = SSL/TLS · 2525 = alternatif (Brevo)
SMTP_PORT=587
# 'true' hanya untuk port 465 (koneksi SSL). Untuk 587 biarkan false.
SMTP_SECURE=false
# Gmail/Zoho: alamat email lengkap. Brevo: email login akun Brevo.
SMTP_USER=you@gmail.com
# Gmail/Zoho: App Password (bukan password akun!). Brevo: SMTP key.
SMTP_PASS=your-app-password-or-smtp-key
# Alamat pengirim yang muncul di email (default: SMTP_USER)
MAIL_FROM=ARKXMotion Studio <you@gmail.com>
# Tampilkan link verifikasi/reset di respons API untuk pengujian lokal.
# Kosong = otomatis (hanya localhost). 1 = paksa tampil, 0 = paksa mati.
# JANGAN isi 1 di produksi: siapa pun yang menebak email bisa memakai link reset.
MAIL_DEV_LINK=

# ─── App URL (dipakai untuk membangun link verifikasi/reset) ───────────
# Lokal: http://localhost:5173
# Produksi (VPS): https://arkxmotion-studio.win
APP_URL=http://localhost:5173

# ─── Backend server (opsional) ─────────────────────────────────────────
# Port Express lokal. Hati-hati: beberapa mesin punya PORT=0 di env global,
# server/index.ts sudah fallback ke 6000.
PORT=6000

# Secret untuk JWT (auth). WAJIB diisi — app tidak akan start tanpa ini!
# Generate dengan: openssl rand -hex 32
JWT_SECRET=
# Refresh token secret (otomatis fallback ke JWT_SECRET-refresh jika kosong)
JWT_REFRESH_SECRET=
# Secret untuk cron internal (GET /api/cron/daily-stats) — set random 32 char
CRON_SECRET=change-me-random-32-char
# Seed admin sekali pakai (server/seed.ts, create-admin2.ts, reset-admin.ts,
# dan rute api/auth.ts?path=seed). Jangan commit nilainya — isi hanya di .env lokal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Kunci rute api/auth.ts?path=seed: header `x-seed-key`, `?secret=`, atau
# `Authorization: Bearer <kunci>`. Harus acak. Selama kosong, rutenya MATI (503)
# — bukan terbuka; salah konfigurasi tidak boleh berubah jadi akses admin.
SEED_KEY=
# Origin tambahan yang diizinkan CORS, dipisah koma (selain default localhost + domain prod)
# Contoh: CORS_ALLOWED_ORIGINS=https://staging.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# ─── Stack Vercel lama (TIDAK dipakai produksi) ────────────────────────
# Hanya dibutuhkan oleh api/*.ts serverless, yang tidak dijalankan di VPS.
# Produksi memakai SQLite di server (lihat ARKXMOTION_DB_PATH).
# DATABASE_URL=postgres://user:pass@host/neondb
# Secret sinkronisasi pengguna untuk api/nexabot-sync-users.ts (hanya Vercel).
# NEXABOT_SYNC_SECRET=

# ─── Proxy NexaBot (opsional) ──────────────────────────────────────────
# nexabot.id /credit & /credits sering lambat (~30s) dan menggantung kalau
# ditembak bersamaan. Nilai di bawah adalah default yang dipakai kalau baris
# ini dibiarkan kosong — isi hanya bila perlu melonggarkan saat upstream ramai.
# Jeda antar percobaan probe (backoff + jitter):
NEXABOT_PROXY_RETRY_BASE_MS=500
NEXABOT_PROXY_RETRY_MAX_MS=4000
# Batas Retry-After dari upstream yang mau ditunggu proxy (ms)
NEXABOT_PROXY_RETRY_MAX_RETRY_AFTER_MS=10000
# Probe saldo/sesi read-only yang boleh jalan bersamaan per instance
NEXABOT_PROBE_CONCURRENCY=2
# Batas menunggu slot antrean probe sebelum menyerah 504 (ms)
NEXABOT_PROBE_QUEUE_MAX_WAIT_MS=25000
#
# Kunci induk NexaBot: relay yang memasangnya, dan TIDAK PERNAH dikirim ke
# browser. Kosong = fitur mati (perilaku lama: klien mengirim kuncinya sendiri).
#   NEXABOT_MASTER_KEY_MODE  unlimited-or-balance (default) | unlimited | off
#   NEXABOT_MASTER_DAILY_CAP  0/kosong = tanpa batas
# Rotasi kunci lama yang masih beredar di browser: NEXABOT_MASTER_KEY.md
NEXABOT_MASTER_API_KEY=
NEXABOT_MASTER_KEY_MODE=unlimited-or-balance
NEXABOT_MASTER_DAILY_CAP=

# ─── Kunci induk Seavi Labs (opsional) ───────────────────────────────────
# Sama seperti NexaBot: relay yang memasang kunci ini untuk member yang sudah
# top up token Seavi — TIDAK PERNAH dikirim ke browser. Kosong dan tidak ada
# nilai di dashboard = fitur mati (klien wajib mengirim kuncinya sendiri lewat
# header Authorization, perilaku lama).
# Nilai dari dashboard admin menang atas env.
SEAVI_MASTER_API_KEY=

# ─── Akses token RunningHub (JWT) ─────────────────────────────────────────
# RunningHub mengautentikasi panggilan OpenAPI dengan access token hasil
# login, bukan API key lama. Relay (server/routes/publicRunninghub.ts) memakai
# token ini sebagai credential DEFAULT untuk semua request upstream — pengguna
# tidak perlu menyimpan API key, dan token tidak pernah dikirim ke browser.
#   • Kosong / tidak diisi → mode lama: tiap pengguna memakai key-nya sendiri
#   • Diisi token          → dipakai untuk SEMUA request upstream RunningHub
# Token punya masa berlaku (klaim `exp` di dalam JWT). Kalau muncul error
# "Access token RunningHub kedaluwarsa", ganti nilainya lalu restart server.
RUNNINGHUB_ACCESS_TOKEN=

# ─── Verifikasi otomatis pembayaran QRIS manual (kode unik + email) ───────
# QRIS statis tidak punya API, jadi identitas pembayaran dipindahkan ke
# NOMINAL: tiap pengajuan top-up diberi kode unik 3 digit (Rp 50.000 →
# Rp 50.137). Server membaca notifikasi transfer masuk dari inbox ini tiap
# 5 menit; nominal masuk yang cocok dengan `amount_total` baris pending
# otomatis mengkredit saldo (wallet CreatePulse/NexaBot/PosBot/Seavi) atau
# menandai LUNAS menunggu approve admin (provider manual / paket Unlimited).
#
# Caranya: buat inbox khusus (mis. email baru / Gmail), lalu set forwarding
# notifikasi dari bank/e-wallet kamu ke inbox ini (BCA/Mandiri/BNI/DANA/GoPay
# semua bisa kirim email tiap mutasi; Gmail butuh App Password, bukan sandi
# login biasa — myaccount.google.com/apppasswords).
#   • PAYMENT_IMAP_ENABLED=false  → matikan watcher tanpa menghapus kredensial
#   • Kosong semua                → watcher tidak jalan (catatan di log saat boot)
PAYMENT_IMAP_HOST=imap.gmail.com
PAYMENT_IMAP_PORT=993
PAYMENT_IMAP_SECURE=true
PAYMENT_IMAP_USER=
PAYMENT_IMAP_PASS=
PAYMENT_IMAP_ENABLED=true

# ─── Companion Android (notifikasi bank/e-wallet → verifikasi otomatis) ───
# App Android "ARKX Payment Monitor" membaca push notification pembayaran di
# HP lewat NotificationListenerService lalu mengirim teks notifikasinya ke
#   POST https://<domain>/api/payments/ingest   header: x-payment-secret
# Server mencocokkan nominal dengan kode unik (sama seperti jalur email).
# Secret ini dipasang sekali di app; ganti nilai ini untuk merotasi akses.
PAYMENT_INGEST_SECRET=

# ─── VelianPay — checkout QRIS dinamis (opsional, direkomendasikan) ─────
# Merchant VelianPay (velianpay.my.id): checkout QRIS dinamis per transaksi,
# nominal unik & verifikasi otomatis lewat API + webhook. Buat akun → ambil
# API key di dashboard → isi di sini; kosongkan VELIANPAY_ENABLED untuk
# menonaktifkan (jalur email/paste tetap jalan sebagai cadangan).
VELIANPAY_BASE_URL=https://velianpay.my.id
VELIANPAY_API_KEY=
VELIANPAY_ENABLED=false
# Webhook: URL publik yang dipanggil VelianPay setelah pembayaran. Signature
# X-VelianPay-Signature = HMAC-SHA256 hex dari BODY MENTAH memakai secret ini
# (BUKAN API key). Cocokkan dengan webhook secret di dashboard merchant.
VELIANPAY_CALLBACK_URL=https://arkxmotion-studio.win/api/public/velianpay/webhook
VELIANPAY_WEBHOOK_SECRET=

# ─── R2 Object Storage (Cloudflare) ─────────────────────────────────────
# Untuk menyimpan permanen hasil video (mis. blob NexaBot) agar tidak hilang
# saat reload dan bisa di-share. Tanpa ini, upload ke CDN gagal dan app
# otomatis pakai URL sementara (blob:).
# Buat di: Cloudflare Dashboard → R2 Object Storage → Create Bucket,
# lalu Manage R2 API Tokens → Create API Token (Object Read & Write).
# Aktifkan public access: bucket Settings → Public Access → Allow Access
# (dapat URL https://<bucket>.<account>.r2.dev) lalu isi R2_PUBLIC_URL.
# Public access itu WAJIB untuk hasil generate: tanpa itu unggahan sukses tapi
# browsernya 404, dan karena tidak jadi URL publik file tetap ikut dipangkas.
# scripts/verify-r2.mjs ikut membuka objek uji lewat URL publik.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
#
# Nilai di atas dibaca saat modul server dimuat, jadi harus berada di .env —
# bukan cuma diekspor di shell. Setelah diisi, urutannya:
#   1. node scripts/verify-r2.mjs        (bukti round-trip ke bucket)
#   2. node scripts/seed-r2-backups.mjs  (unggah snapshot lama SEBELUM prune menyala)
#   3. pm2 restart arkxmotion --update-env
# Rinciannya: R2_BACKUP_SETUP.md

# ─── Retention hasil generate di disk ───────────────────────────────────
# Tanpa R2, hasil video disimpan di uploads/ dan tumbuh ~1,5 GB/hari. Server
# menghapus file lebih tua dari ini saat start lalu tiap 6 jam. 0 = mati.
# Kalau disk penuh, nginx gagal men-buffer body besar dan membalas HTML
# (frontend melihat "Unexpected token '<'") — jadi jangan dibiarkan kosong
# tanpa R2.
UPLOAD_RETENTION_DAYS=

# ─── Backup otomatis ────────────────────────────────────────────────────
# Kosong = snapshot saat start + scheduler R2 hanya jalan di production.
# Isi 1 untuk memaksa aktif (mis. saat menguji backup di lokal),
# isi 0 untuk memaksa mati walau di production.
AUTO_BACKUP=

# Jadwal dan retensi backup terjadwal. Scheduler hanya menyala kalau
# R2_ACCOUNT_ID terisi dan AUTO_BACKUP tidak dimatikan.
#   BACKUP_INTERVAL_MS — jarak antar backup berkala (default 21600000 = 6 jam)
#   BACKUP_KEEP_LOCAL  — jumlah snapshot yang disimpan di disk VPS (default 7)
#   BACKUP_KEEP_R2     — jumlah snapshot yang disimpan di R2 (default 30)
# Naikkan BACKUP_KEEP_R2 kalau riwayat lama dari seed ingin tetap tersimpan,
# karena backup terjadwal pertama akan memangkas R2 ke batas itu.
BACKUP_INTERVAL_MS=
BACKUP_KEEP_LOCAL=
BACKUP_KEEP_R2=

# ─── Deploy VPS — dipakai deploy_vps.py (bukan runtime server) ───
# Isi di .env (di-ignore git). Kredensial tidak boleh ditanam di skrip:
# skrip deploy membacanya dari sini, dan berhenti bila kurang lengkap.
VPS_HOST=
VPS_PORT=22
VPS_USER=
VPS_PASSWORD=
VPS_REMOTE_DIR=/opt/arkxmotion-studio

# ─── AI ARKX AUTO Studio — kunci Gemini milik server (relay /api/public/studio-ai) ───
# Disalin ke .env VPS oleh deploy_vps.py bila belum ada. Bisa juga diisi
# lewat System Settings (menang atas env).
GEMINI_API_KEY=

# ============================================================
# ─── Tambahan runtime (opsional — semua punya default di kode) ───
# Baris di bawah tidak wajib diisi; default-nya tertulis di kode sumber.
# Isi hanya kalau perlu mengubah perilaku default.
# ============================================================

# ─── Database SQLite ───────────────────────────────────────────────────
# Lokasi file database. Default: data/arkxmotion.db (di-ignore git).
# ARKXMOTION_DB_PATH=

# ─── Penyimpanan hasil generate di disk ────────────────────────────────
# Folder unggahan lokal. Default: ./uploads di direktori kerja server.
# UPLOAD_DIR=

# ─── Notifikasi kegagalan (Slack/Discord/Telegram webhook) ─────────────
# Server mengirim alert kalau ada kegagalan penting. Kosong = alert mati.
# ALERT_WEBHOOK_URL=
# Nama server yang ikut disertakan di pesan alert (default: arkxmotion-studio).
# SERVER_NAME=

# ─── Base URL provider lain ────────────────────────────────────────────
# Hanya perlu diubah kalau provider memindahkan endpoint-nya.
# NEXABOT_BASE=https://nexabot.id
# SEAVI_BASE=https://api.seavilabs.site/v1
# POSBOT_BASE=https://api.posbot.web.id/api/v1
# FREEBEAT_BASE=https://freebeat.ai/api/proxy
# MARKASTOOLS_BASE=https://ai.markastools.id
# Saldo PosBot yang dilaporkan operator (Rp, default 4650) — dipakai
# route /api/saldo-penyedia saat operator tidak bisa mengambil angka live.
# POSBOT_REPORTED_BALANCE=

# ─── Kunci admin proxy CreatePulse ─────────────────────────────────────
# Dipakai route publicCreatepulse untuk memanggil endpoint admin upstream.
# CREATEPULSE_API_KEY=

# ─── Antrean submit & job lock NexaBot ─────────────────────────────────
# Default aman untuk pemakaian normal; naikkan hanya saat upstream ramai.
#   NEXABOT_SUBMIT_CONCURRENCY      submit bersamaan per kredensial (default 1)
#   NEXABOT_SUBMIT_QUEUE_MAX_WAIT_MS menunggu slot antrean sebelum "antrian penuh" (ms, default 45000)
#   NEXABOT_SUBMIT_RETRY_AFTER_S    Retry-After yang dianjurkan saat penuh (detik, default 10)
#   NEXABOT_JOB_MAX_HOLD_MS         umur keras satu job (ms, default 1500000 = 25 menit)
#   NEXABOT_JOB_IDLE_MS             job tak dipoll dianggap selesai (ms, default 480000 = 8 menit)
#   NEXABOT_JOB_BUSY_RETRY_AFTER_S  Retry-After saat job sedang jalan (detik, default 15)
#   NEXABOT_JOB_MAX_RETRY_AFTER_S   batas atas Retry-After (detik, default 90)
#   NEXABOT_JOB_BUSY_COOLDOWN_MS    jeda setelah upstream menolak (ms)
# NEXABOT_SUBMIT_CONCURRENCY=
# NEXABOT_SUBMIT_QUEUE_MAX_WAIT_MS=
# NEXABOT_SUBMIT_RETRY_AFTER_S=
# NEXABOT_JOB_MAX_HOLD_MS=
# NEXABOT_JOB_IDLE_MS=
# NEXABOT_JOB_BUSY_RETRY_AFTER_S=
# NEXABOT_JOB_MAX_RETRY_AFTER_S=
# NEXABOT_JOB_BUSY_COOLDOWN_MS=

# ─── Pool token RunningHub ─────────────────────────────────────────────
# RUNNINGHUB_POOL_MAX         kapasitas akun di pool (default 1000, maks 5000)
# RUNNINGHUB_DAILY_CLAIM      1 = paksa scheduler klaim harian menyala di luar
#                             production; kosong = otomatis hanya di production,
#                             0 = selalu mati
# RUNNINGHUB_POOL_MAX=
# RUNNINGHUB_DAILY_CLAIM=

# ─── Integrasi berbasis cookie ─────────────────────────────────────────
# CHATGPT_COOKIES — cookie sesi Chatgpt untuk route server/routes/chatgpt.ts.
# Tanpa ini route itu menolak dengan error "CHATGPT_COOKIES not configured".
# Isi nilai cookie sesi dari browser (bukan password); rotasi bila sesi mati.
# CHATGPT_COOKIES=

# ─── Eksternal ─────────────────────────────────────────────────────────
# PYTHON_EXECUTABLE — interpreter Python untuk relay watermark RunningHub
# (default: python3 di PATH server).
# PYTHON_EXECUTABLE=

# ─── Membership RoboNeo ────────────────────────────────────────────────
# ROBONEO_TRACKING_TOKEN — token tracking paket membership; kode sudah
# membawa nilai default, isi hanya untuk mengganti/mengrotasi.
# ROBONEO_TRACKING_TOKEN=
