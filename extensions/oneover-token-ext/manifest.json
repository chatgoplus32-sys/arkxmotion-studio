{
  "manifest_version": 3,
  "name": "OneOver Token Manager",
  "description": "Auto-capture Supabase tokens from oneover.com for ARKx Motion Studio",
  "version": "1.1.0",
  "minimum_chrome_version": "88",
  "permissions": [
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://mjuwtqkfhtpgavwjrual.supabase.co/*",
    "https://oneover.com/*",
    "https://*.supabase.co/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
