{
  "manifest_version": 3,
  "name": "Riverside Token Manager",
  "description": "Auto-capture + keep-alive token Riverside — auto-sync JWT terbaru ke app ARKx Motion Studio (tanpa copy-paste)",
  "version": "1.3.0",
  "minimum_chrome_version": "88",
  "permissions": [
    "storage",
    "activeTab",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://riverside.com/*",
    "https://*.riverside.com/*",
    "https://securetoken.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://riverside.com/*",
        "https://*.riverside.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
