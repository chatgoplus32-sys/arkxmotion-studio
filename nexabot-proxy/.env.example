# Nexabot Proxy — Environment Variables

# API key induk dari Nexabot (WAJIB)
NEXABOT_MASTER_KEY=your-nexabot-master-key-here

# Base URL Nexabot API
NEXABOT_BASE_URL=https://api.nexabot.com

# Port server proxy
PORT=3000

# Biaya per generate untuk mode topup (Rupiah)
# Default: 250 perak
COST_PER_GENERATE=250

# Path database SQLite
# DB_PATH=./members.db

# Admin key untuk akses endpoint admin
# Ganti dengan string acak yang kuat!
ADMIN_KEY=change-me-admin-key

# ── RunningHub AI Integration ──
# API Keys dari RunningHub (pisahkan dengan koma untuk auto-rotate)
# Contoh: RUNNINGHUB_API_KEYS=key1,key2,key3
RUNNINGHUB_API_KEYS=your-runninghub-api-key-here

# WebApp ID workflow Virtual Try-On & Ekstraksi Pakaian
RUNNINGHUB_WEBAPP_ID=2099800742046818306

# ── UGC Storyboard (MiniMax H3 I2V — Gambar ke Video + Audio) ──
# WebApp ID workflow: https://www.runninghub.ai/id/ai-detail/2096092981395841025
RUNNINGHUB_UGC_WEBAPP_ID=2096092981395841025
# Batas jumlah gambar scene per video (default 4 di dashboard, server izinkan 10)
UGC_MAX_SCENES=4
# Batas durasi video dalam detik (default 15, workflow MiniMax H3 I2V)
UGC_MAX_DURATION=15

# ── Chat GPT Proxy (/openai/v1/*) ──
# Fitur chat GPT otomatis pakai NEXABOT_MASTER_KEY & NEXABOT_BASE_URL di atas.
# Kalau mau pakai provider lain (OpenAI langsung, Together AI, dll), uncomment:
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_DEFAULT_MODEL=gpt-4o

# ── Default Provider (LOCKED) ──
# 🔒 Motion control provider DIKUNCI ke RunningHub
# Tidak bisa diganti — ini adalah satu-satunya provider yang didukung
# Fitur: Virtual Try-On, Ekstraksi Pakaian, Motion Control
# Model: FireRed 2-in-1, Qwen-Image-Lightning, Qwen 2.5 VL 7B
# MOTION_CONTROL_PROVIDER=runninghub  # ← TIDAK BISA DIGANTI

# ── Sync dengan Arkx Motion Studio ──
# Path SQLite database Arkx Studio (read-only)
ARKX_DB_PATH=/opt/arkxmotion-studio/data/arkxmotion.db

# ── Kredensial VPS (skrip deploy di folder ini) ──
# Dibaca oleh deploy-vps.py, _setup-monitor.py, dan fix-deploy.py lewat
# vps_config.py — jadi kuncinya hanya ada di satu tempat. Isi di .env
# (di-ignore git); jangan pernah ditanam kembali di dalam skrip.
# Tanpa ketiga kunci wajib ini, skrip berhenti dengan pesan jelas dan
# TIDAK memakai nilai bawaan yang bisa mengarah ke server yang salah.
VPS_HOST=
VPS_PORT=22
VPS_USER=
VPS_PASSWORD=
# Folder tujuan di VPS untuk berkas nexabot-proxy.
VPS_REMOTE_DIR=/home/arkxmotion/nexabot-proxy
