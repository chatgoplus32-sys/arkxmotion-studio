# Nexabot Proxy — Environment Variables

# API key induk dari Nexabot (WAJIB)
NEXABOT_MASTER_KEY=your-nexabot-master-key-here

# Base URL Nexabot API
NEXABOT_BASE_URL=https://api.nexabot.com

# Port server proxy
PORT=3000

# Biaya per generate untuk mode topup (Rupiah)
# Default: 250 perak
COST_PER_GENERATE=250

# Path database SQLite
# DB_PATH=./members.db

# Admin key untuk akses endpoint admin
# Ganti dengan string acak yang kuat!
ADMIN_KEY=change-me-admin-key

# ── RunningHub AI Integration ──
# API Key dari RunningHub (untuk fitur Virtual Try-On)
RUNNINGHUB_API_KEY=your-runninghub-api-key-here

# WebApp ID workflow Virtual Try-On & Ekstraksi Pakaian
RUNNINGHUB_WEBAPP_ID=2099800742046818306

# ── Sync dengan Arkx Motion Studio ──
# Path SQLite database Arkx Studio (read-only)
ARKX_DB_PATH=/opt/arkxmotion-studio/data/arkxmotion.db
