{
  "manifest_version": 3,
  "name": "OneOver Auth Helper",
  "version": "1.0",
  "description": "Extract Supabase tokens from oneover.com for ARKXMotion Studio",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://oneover.com/*"],
  "content_scripts": [
    {
      "matches": ["https://oneover.com/*"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OneOver Auth Helper"
  }
}